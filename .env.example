# Copy to .env (npm run setup does this). Secrets are never written here in
# plain text: Keysmith puts keysmith:// placeholders in .env and injects the
# real values at run time (keysmith run -- <command>).

# Local Postgres. `npm run setup` creates the database.
DATABASE_URL=postgres://localhost:5432/interview

# Real Postgres for the concurrency test suite (npm run test:pg).
TEST_DATABASE_URL=postgres://localhost:5432/interview_test

# Admin login password. Required in production; pick a long random value.
ADMIN_PASSWORD=
# Secret for signing the admin session cookie and hashing IP addresses.
SESSION_SECRET=

# Research engine. All optional: without them those stages only run on fixtures.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GITHUB_TOKEN=

# Models (ids are confirmed in docs/pipeline.md).
EXTRACTION_MODEL=claude-haiku-5-5
RATIONALE_MODEL=claude-opus-5-5

# Stop a research run that would cost more than this many US dollars.
RESEARCH_MAX_COST_USD=2
