    "research:inspect": "tsx src/cli/inspect.ts",
    "research:worker": "tsx src/cli/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@mozilla/readability": "^0.6.0",
    "drizzle-orm": "^0.45.4",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
